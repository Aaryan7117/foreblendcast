<?xml version="1.0" encoding="utf-8"?>
<!-- The FastAPI dev server speaks plain HTTP on the LAN / emulator host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
